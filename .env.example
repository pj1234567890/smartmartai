# Copy this file to .env and fill in your local PostgreSQL credentials.
DB_URL=jdbc:postgresql://localhost:5432/smartmart
DB_USERNAME=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
# Use one stable, private value (at least 32 UTF-8 characters). Changing it invalidates existing sessions.
JWT_SECRET=REPLACE_WITH_A_STABLE_PRIVATE_SECRET_AT_LEAST_32_CHARACTERS

# OpenRouter AI Configuration (optional - leave blank to use rule-based recommendations)
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Goods Receiving (all optional - uncomment and set only what you need;
# leaving a variable commented out keeps the built-in default.
# Where uploaded supplier invoices are stored (kept outside the webapp and database).
#SMARTMART_UPLOAD_DIR=C:/smartmart-invoices
# Maximum invoice upload size in MB (default 10).
#SMARTMART_MAX_UPLOAD_MB=10
# Set to false to disable local OCR (invoices are then entered manually).
#SMARTMART_OCR_ENABLED=true
# Folder containing eng.traineddata for Tesseract OCR, e.g. C:/Program Files/Tesseract-OCR/tessdata
#SMARTMART_TESSDATA=
# Tesseract language code (default eng).
#SMARTMART_TESS_LANG=eng
